# =============================================================================
# IT Support AI Agent — environment template
# Copy to .env and adjust. NEVER commit real secrets.
# =============================================================================

# --- Runtime environment: development | staging | production | test ---
ENVIRONMENT=development

# --- Database (PostgreSQL + pgvector) ---
# Host-side tools (Vite dev proxy, local uvicorn) use localhost:5432, which the
# Docker stack publishes on loopback only. Inside compose, the backend uses
# POSTGRES_SERVER=db automatically (set in docker-compose.yml).
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=itsupport_db
POSTGRES_PORT=5432

# --- Primary LLM: Gemini (grounded synthesizer + intent router) ---
# Without a key the agent runs in deterministic fallback mode (fully functional,
# no LLM calls). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings ---
# provider: local (SentenceTransformers, default, no API key needed) | openai
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
# all-MiniLM-L6-v2 produces 384-dimensional embeddings.
# If you switch EMBEDDING_PROVIDER=openai (text-embedding-3-small), set 1536
# AND re-run `alembic upgrade head` after creating a new migration, plus reindex.
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# --- Security ---
# Required to be non-default in production. Generate: openssl rand -hex 32
SECRET_KEY=change-this-in-production
# Explicit allow-list — comma-separated (JSON array form also accepted).
# Wildcard "*" is rejected in production.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting (requests per minute per client IP) ---
RATE_LIMIT_PER_MINUTE=120

# --- Docker stack: host port for the nginx/SPA container ---
# Change if the port is already in use on the host (default 3001).
NGINX_PORT=3001
